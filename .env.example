# Secrets: do not commit .env. All configuration is validated before service startup.
MATTERMOST_URL=https://mattermost.example.com
MATTERMOST_BOT_TOKEN=
# YAML channel_ids accepts comma-separated IDs from this variable.
MATTERMOST_CHANNEL_IDS=
# OpenAI: server-side API key with permission to create audio transcriptions.
OPENAI_API_KEY=
S3_BUCKET=
S3_REGION=eu-central-1
# Leave empty for AWS; set e.g. https://s3.example.com for compatible storage.
S3_ENDPOINT_URL=
S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for temporary AWS credentials:
AWS_SESSION_TOKEN=
# Optional Buffer integration: create a personal key in Buffer Settings -> API.
BUFFER_API_KEY=
